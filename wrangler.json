{
  "compatibility_date": "2025-10-08",
  "main": "src/server/index.ts",
  "name": "durable-chat-template",

  "migrations": [
    {
      "new_sqlite_classes": ["Chat"],
      "tag": "v1"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "class_name": "Chat",
        "name": "Chat"
      }
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat-users",
      "database_id": "a8792c0f-1158-40df-ae7c-96a2790b6c2f"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "build": {
    "command": "esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist"
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true
}
